# ==============================================================================
# DigiTube Network / DigiTube Backstage - Environment Configuration
# ==============================================================================

# Database Connection
MONGODB_URI="mongodb+srv://user:password@cluster0.mongodb.net/digitube_backstage?retryWrites=true&w=majority"
MONGODB_DB="digitube_backstage"
DATABASE_URL="mongodb+srv://user:password@cluster0.mongodb.net/digitube_backstage?retryWrites=true&w=majority"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="DigiTube Network Backstage"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Distribution Partner API (Revelator / SonoSuite / FUGA / DDEX sandbox adapter)
DSP_PROVIDER_ENV="sandbox"
DSP_REVELATOR_API_KEY="rev_live_sandbox_key_sample"
DSP_REVELATOR_SECRET="rev_secret_sample"
DSP_WEBHOOK_SECRET="whsec_digitube_dsp_webhook"

# Storage Configuration (S3 / Cloudflare R2 for Master Audio WAV & Hi-Res Artwork)
STORAGE_PROVIDER="mock-s3"
STORAGE_BUCKET="digitube-music-assets"
STORAGE_REGION="ap-south-1"

# Financial & Payout Configuration
DEFAULT_CURRENCY="INR"
MIN_PAYOUT_AMOUNT="1000"
DIGITUBE_DEFAULT_COMMISSION="15" # 15% DigiTube commission, 85% Artist share

# Email (SMTP) Configuration for sending Real Verification OTP Emails
# (Use your Gmail with an App Password or Brevo/SendGrid)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM='"DigiTube Backstage" <no-reply@digitubenetwork.com>'
